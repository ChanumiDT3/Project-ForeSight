# Dev/preview server port. The hosted preview conventionally uses 3000.
PORT=3000

# Absolute backend origin the browser calls, e.g. https://backend.example.com
# Leave empty to call the API on the frontend's own origin (via the proxy below).
# The backend's FORESIGHT_CORS_ORIGINS must list this frontend's own address
# whenever the API is on a different origin.
VITE_API_BASE_URL=

# Optional: backend origin that the Vite dev server proxies /v1 and /health to.
# Example for local development: http://localhost:8000
VITE_BACKEND_PROXY_TARGET=
