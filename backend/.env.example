# SQLite storage location; request this value through deployment configuration.
FORESIGHT_DATABASE_URL=sqlite:///./foresight.db

# Fixed plant ID stamped onto every record and used to scope user selection.
FORESIGHT_PLANT_ID=plant-1

# Comma-separated React/Vite frontend origin(s); CORS is disabled when omitted.
FORESIGHT_CORS_ORIGINS=http://localhost:5173

# Optional recipient identifier included in safe operational failure logs.
FORESIGHT_OPERATIONAL_RECIPIENT=maintenance-operations@example.com
